# Copiá este archivo como .env y completalo con los datos de tu app web de Firebase
# (Configuración del proyecto → Tus apps → SDK setup and configuration).
# Si lo dejás vacío, la app funciona en "modo local": guarda todo solo en este navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
